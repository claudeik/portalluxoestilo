# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
PORT=3001

# ──────────────────────────────────────────────────────────────
# Database & Analytics (Postgres-as-Lake ADR-0009)
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal_estilo_luxo
DATABASE_REPLICA_URL=postgresql://portal:portal@localhost:5433/portal_estilo_luxo
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ──────────────────────────────────────────────────────────────
# Banco parceiro (Pix split) — Stone / Celcoin / Inter
# ──────────────────────────────────────────────────────────────
BANCO_PARCEIRO_API_URL=https://api.banco-parceiro.com.br
BANCO_PARCEIRO_CLIENT_ID=portal_dev_client
BANCO_PARCEIRO_CLIENT_SECRET=portal_dev_secret
BANCO_PARCEIRO_WEBHOOK_SECRET=whsec_portal_estilo_luxo_2026
BANCO_PARCEIRO_ACCOUNT_PORTAL=acc_portal_20pct
BANCO_PARCEIRO_ACCOUNT_UNICENTRO=acc_unicentro_py
BANCO_PARCEIRO_ACCOUNT_EPYX=acc_epyx_5pct
BANCO_PARCEIRO_ACCOUNT_TAX=acc_sefaz_icms

# ──────────────────────────────────────────────────────────────
# Bling (ERP — NF-e + Etiquetas)
# ──────────────────────────────────────────────────────────────
BLING_API_URL=https://api.bling.com.br/v3
BLING_ACCESS_TOKEN=
BLING_API_KEY=

# ──────────────────────────────────────────────────────────────
# Correios (SRO-eXML + SIGEP)
# ──────────────────────────────────────────────────────────────
CORREIOS_USER=
CORREIOS_PASS=
CORREIOS_CONTRATO=
CORREIOS_BASE_URL=https://webservice.correios.com.br
CORREIOS_SIGEP_URL=https://apphom.correios.com.br/SigepMasterJPA/AtendeClienteService/AtendeCliente

# ──────────────────────────────────────────────────────────────
# Unicentro (Catálogo + Estoque PY)
# ──────────────────────────────────────────────────────────────
UNICENTRO_API_URL=https://api.unicentro.com.py/v1
UNICENTRO_API_KEY=

# ──────────────────────────────────────────────────────────────
# Câmbio (Banco Central PTAX)
# ──────────────────────────────────────────────────────────────
BCB_PTAX_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
USD_BRL_SPREAD=0.00

# ──────────────────────────────────────────────────────────────
# OpenAI (Vision IA + Embeddings pgvector)
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ──────────────────────────────────────────────────────────────
# Mux (Live Shopping)
# ──────────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ──────────────────────────────────────────────────────────────
# Storage (MinIO / S3)
# ──────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=portal_minio
S3_SECRET_KEY=portal_minio_secret
S3_BUCKET=portal-estilo-luxo
S3_REGION=us-east-1

# ──────────────────────────────────────────────────────────────
# Observabilidade & Analytics
# ──────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
METABASE_URL=http://localhost:3002
METABASE_API_KEY=
SLACK_WEBHOOK_ANOMALY=
